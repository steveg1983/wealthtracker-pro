# WealthTracker environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# SECURITY RULE: VITE_-prefixed variables are inlined into the public browser
# bundle by Vite. Only publishable/anon keys may use the VITE_ prefix.
# Server-side secrets (service-role, Clerk secret, Stripe secret, encryption
# keys) must NOT have a VITE_ prefix and are read via process.env in api/.

# --- Client-safe (public) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_SENTRY_DSN=

# --- Server-only secrets (no VITE_ prefix — never bundled) ---
CLERK_SECRET_KEY=sk_test_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ENCRYPTION_KEY=
BANKING_STATE_SECRET=
# Comma-separated front-end origins allowed to call this API. UNSET = the token's
# `azp` claim is not checked, so ANY token minted by this Clerk instance is
# accepted no matter which site asked for it. api/_lib/auth.ts warns on every
# cold start until this is set.
CLERK_AUTHORIZED_PARTIES=https://your-app.example.com,http://localhost:5173

# --- Stripe (server-only) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Server-side price IDs — prices are NEVER trusted from the client
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# --- TrueLayer (server-only) ---
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=
TRUELAYER_ENVIRONMENT=sandbox
CRON_SECRET=
AUDIT_LOG_RETENTION_DAYS=2190

# --- Fail-closed controls (server-only) ---
# Leaving any of these unset does NOT open a door — each one shuts something off.
# They are listed here because the failure is silent and easy to misread as a bug.

# Clerk user ids allowed to reach the banking ops/dead-letter admin endpoints
# (they can reset every user's bank connections). UNSET = nobody is an ops admin
# in any runtime, and /api/banking/health returns only a coarse ok|degraded.
BANKING_OPS_ADMIN_CLERK_IDS=

# Comma-separated origins accepted for CORS and as checkout/portal redirect
# targets. UNSET = only this deployment's own https://$VERCEL_URL is allowed
# (plus localhost on a developer machine — never on preview/production, which
# share the live Supabase project).
BANKING_ALLOWED_ORIGINS=

# Upstash Redis backs the API rate limiter's shared window. UNSET = the limiter
# silently degrades to per-instance in-memory counting, so the effective limit
# multiplies by the number of live serverless instances.
# (KV_REST_API_URL/KV_REST_API_TOKEN are accepted as aliases.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
