{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,

    /* Path mappings */
    "baseUrl": ".",
    "paths": {
      /* The edition seam. This project is the WEB app, so `@data` is the web
         app's engine. tsconfig.desktop.json maps the same specifier to the
         device's, and compiles the desktop renderer against it — which is how
         the substitution is checked by the compiler in both directions rather
         than only in the one that happens to be built. See
         docs/edition-gating.md. */
      "@data": ["./src/services/port/index.ts"],
      /* The mount slice's four seams, cloud halves. tsconfig.desktop.json maps
         the same four specifiers at the device halves, so a shared surface that
         only typechecks against one edition's furniture is a compile error in
         whichever project it broke. */
      "@chrome": ["./src/editions/cloud/chrome.tsx"],
      "@identity": ["./src/editions/cloud/identity.ts"],
      "@prefs-store": ["./src/editions/cloud/preferencesStore.ts"],
      "@rules-store": ["./src/editions/cloud/rulesStore.ts"],
      "@telemetry": ["./src/editions/cloud/telemetry.ts"],
      /* The mount slice's second half: the state layer's preamble, and the
         three settings panels that are about the hosted service. */
      "@session": ["./src/editions/cloud/session.ts"],
      "@service": ["./src/editions/cloud/service.ts"],
      "@wealthtracker/utils": ["./packages/utils/index.ts"],
      "@wealthtracker/utils/*": ["./packages/utils/*"],
      "@wealthtracker/types/*": ["./packages/types/*"],
      "@app-types/*": ["./src/types/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.cy.ts",
    "src/**/*.cy.tsx",
    "src/**/__tests__/**",
    "src/test/**",
    /* The desktop renderer belongs to tsconfig.desktop.json, which resolves
       `@data` to the device engine. Compiling it here as well would compile it
       against the wrong one. */
    "src/desktop/**"
  ]
}
