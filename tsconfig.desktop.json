{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.desktop.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — the same as tsconfig.app.json's, because the modules this
       reaches into are the same modules. `types` is stated here and not there
       only because that project picks `vite/client` up from src/vite-env.d.ts,
       which is inside its own `include` and outside this one. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,

    "baseUrl": ".",
    "paths": {
      /* The edition seam, pointed at the DEVICE engine — the whole difference
         between this project and tsconfig.app.json. Any shared surface the
         desktop renderer mounts is compiled here against the port a file
         provides, so a component that only typechecks against DataService is a
         build error in this project rather than a discovery at run time. */
      "@data": ["./src/services/local/deviceDataPort.ts"],
      "@wealthtracker/utils": ["./packages/utils/index.ts"],
      "@wealthtracker/utils/*": ["./packages/utils/*"],
      "@wealthtracker/types/*": ["./packages/types/*"],
      "@app-types/*": ["./src/types/*"]
    }
  },
  /* `src/desktop` and nothing else of src: the renderer lives inside this
     repo's lint, typecheck and test roots on purpose (deviceDocument.ts's
     header gives the reason), and everything it reaches is compiled with it. */
  "include": ["src/desktop", "apps/desktop/vite.config.ts"],
  "exclude": ["src/desktop/**/__tests__/**"]
}
